        "start": 20913,
        "end": 21561,
        "before": "",
        "after": "\n// Exact D72-05 copy. Separate from the accepted teaching and scenario graph.\nexport const loopTransfer = {\n  heading: 'Apply the Loop somewhere else',\n  optional:\n    'Optional reflection. This is a fictional situation. Think it through or use your own paper privately. There is no answer to submit.',\n  scenario:\n    'A coworker is waiting for an update you promised. The task is unfinished. You can send an honest update now, or wait until the result looks better.',\n  reflection:\n    'Identify the pressure, the standard and the action that would create real evidence. Then consider what changes if communication is unavailable.',\n} as const;\n"
      }
    ]
  },
  "src/loop-state.ts": {
    "beforeSha256": "45d757ea15eebc530a73908e147b982314ab69c733c0c3d463805892b1efa07d",
    "afterSha256": "acd718ed0ac73413ed4d2c0208ce87999d7ed2716ae185a4fead41e9ace1f5d3",
    "edits": [
      {
        "start": 726,
        "end": 1581,
        "before": "",
        "after": "\nexport type LoopSelection = { state: LoopStateId; history: LoopStateId[]; revision: number };\nexport const initialLoopSelection = (state: LoopStateId): LoopSelection => ({\n  state,\n  history: [],\n  revision: 0,\n});\nexport function chooseLoopOutcome(selection: LoopSelection, option: number): LoopSelection {\n  if (!loopScenario.states[selection.state].options[option]) return selection;\n  return {\n    state: nextLoopState(selection.state, option),\n    history: [...selection.history, selection.state],\n    revision: selection.revision + 1,\n  };\n}\nexport function previousLoopChoice(selection: LoopSelection): LoopSelection {\n  const previous = selection.history.at(-1);\n  return previous === undefined\n    ? selection\n    : {\n        state: previous,\n        history: selection.history.slice(0, -1),\n        revision: selection.revision + 1,\n      };\n}\n"
      }
    ]
  },
