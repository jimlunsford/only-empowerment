        "after": "#educational-fallback .period-reading p {\n  margin-top: 16px;\n}\n/* Native fragment restoration must not depend on a later web-font layout.\n   Keep the script-independent root reading on immediately available fonts.\n   The enhanced application retains its Source Serif / Source Sans typography. */\n#educational-fallback {\n  font-family: Arial, sans-serif;\n  overflow-wrap: anywhere;\n}\n#educational-fallback :where(*) {\n  font-family: inherit;\n}\n#educational-fallback\n  :is(h1, h2, blockquote, .home-question, .path-name, .path a, .transition-path b) {\n  font-family: Georgia, serif;\n}\n@media (max-width: 1000px) {\n  .period-shell .intro-hero {\n    column-gap: 36px;\n"
      }
