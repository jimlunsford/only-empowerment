  "src/execution.css": {
    "beforeSha256": "ee9500d062288e046c25472a2545e0f1dce76328573e4e3c318e8a0fabbc59f1",
    "afterSha256": "dd376c5ab7853f4e7f1031b090fd510afddb4f1f638ccf334e253db18765dc31",
    "edits": [
      {
        "start": 13403,
        "end": 16154,
        "before": "",
        "after": "\n/* Batch 6: one local bar, a cover-aligned roadmap and compact two-line controls. */\n@media screen {\n  .workshop .workshop-local-nav {\n    display: flex;\n    flex-wrap: wrap;\n    align-items: center;\n    justify-content: space-between;\n    gap: 0.25rem 1.5rem;\n    padding-block: var(--editorial-local-padding);\n    border-bottom: 1px solid var(--editorial-line);\n    font-size: var(--editorial-label-size);\n    line-height: var(--editorial-label-leading);\n    color: var(--editorial-muted);\n  }\n  .workshop .workshop-local-nav .workshop-kicker {\n    margin: 0;\n    padding: 0;\n    font-size: inherit;\n  }\n  .workshop .workshop-local-nav .workshop-position {\n    flex: 1 1 auto;\n    justify-content: space-between;\n    margin: 0;\n    padding: 0;\n    border: 0;\n    font-size: inherit;\n  }\n  .workshop .workshop-local-nav a {\n    font-size: inherit;\n    line-height: inherit;\n    min-height: 44px;\n  }\n  .workshop .workshop-navigation {\n    align-items: flex-start;\n  }\n  .workshop .workshop-navigation a {\n    padding-block: 0.375rem;\n    line-height: 1.2;\n    justify-content: center;\n  }\n  .workshop .workshop-navigation a span {\n    line-height: 1.2;\n  }\n  .workshop[data-workshop='welcome'] .workshop-editorial {\n    display: grid;\n    grid-template-columns: var(--editorial-hero-grid);\n    column-gap: var(--editorial-gap);\n    align-items: start;\n    padding-block: var(--editorial-hero-space);\n  }\n  .workshop[data-workshop='welcome'] .workshop-heading {\n    grid-column: 1;\n    grid-row: 1;\n    min-width: 0;\n    margin: 0 0 1.5rem;\n  }\n  .workshop[data-workshop='welcome'] h1 {\n    margin-top: 0;\n  }\n  .workshop[data-workshop='welcome'] .workshop-purpose {\n    margin-bottom: 0;\n  }\n  .workshop[data-workshop='welcome'] .workshop-layout {\n    display: contents;\n  }\n  .workshop[data-workshop='welcome'] .workshop-main {\n    grid-column: 1;\n    grid-row: 2;\n  }\n  .workshop[data-workshop='welcome'] .workshop-guide {\n    grid-column: 2;\n    grid-row: 1 / span 2;\n    min-width: 0;\n    border: 1px solid var(--editorial-line);\n    border-radius: var(--editorial-radius);\n    background: var(--editorial-surface);\n    padding: var(--editorial-panel-padding);\n  }\n  .workshop[data-workshop='welcome'] .workshop-guide-title {\n    margin-top: 0;\n    font-family: var(--font-display);\n    font-size: var(--editorial-h2);\n    line-height: var(--editorial-heading-leading);\n    font-weight: 400;\n  }\n  .workshop[data-workshop='welcome'] .workshop-guide li {\n    border-top: 1px solid var(--editorial-line);\n  }\n  @media (max-width: 768px) {\n    .workshop[data-workshop='welcome'] .workshop-editorial {\n      display: block;\n    }\n    .workshop[data-workshop='welcome'] .workshop-guide {\n      margin-top: var(--editorial-section-space);\n    }\n  }\n}\n"
      }
    ]
  },
  "src/loop.css": {
    "beforeSha256": "acfead5d3ca5d3b5225e4fff856fdac3d80adb92586842ea96f96f69c55ec76f",
    "afterSha256": "169240732c4711b80fb0b56e0b9ba157f4c1d7543002df21256ae6fa63e93a85",
    "edits": [
      {
        "start": 10139,
        "end": 11620,
        "before": "",
        "after": "\n/* Batch 6: a forest cover panel and a bounded section-jump strip. */\n@media screen {\n  .loop-hero {\n    grid-template-columns: var(--editorial-hero-grid);\n  }\n  .loop-hero > div > .loop-kicker {\n    margin-top: 0;\n  }\n  .loop-hero .loop-cycle {\n    background: var(--editorial-forest);\n    color: var(--editorial-paper);\n    border-color: var(--editorial-forest);\n  }\n  .loop-hero .loop-cycle > .loop-kicker {\n    font-family: var(--font-display);\n    font-size: var(--editorial-h2);\n    font-weight: 400;\n    line-height: var(--editorial-heading-leading);\n    margin: 0 0 1rem;\n  }\n  .loop-hero .loop-cycle li {\n    border-bottom: 0;\n    border-top: 1px solid var(--editorial-anchor-line);\n  }\n  .loop-hero .loop-cycle a {\n    font-family: var(--font-display);\n    font-size: 1.25rem;\n    font-weight: 400;\n    text-decoration: none;\n  }\n  .loop-hero .loop-cycle a:hover {\n    text-decoration: underline;\n  }\n  .loop-hero .loop-cycle-return {\n    border-left: 0;\n    border-top: 1px solid var(--editorial-anchor-line);\n    padding: 1rem 0 0;\n    margin-bottom: 0;\n  }\n  .loop-hero .loop-cycle a:focus-visible {\n    outline-color: var(--editorial-paper);\n  }\n  .loop-experience .loop-section-nav {\n    border-block: 1px solid var(--editorial-line);\n  }\n  @media (max-width: 768px) {\n    .loop-hero {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  @media (forced-colors: active) {\n    .loop-hero .loop-cycle a:focus-visible {\n      outline-color: Highlight;\n    }\n  }\n}\n"
      }
    ]
  },
  "src/period-homepage.css": {
    "beforeSha256": "038e8f081eca007358feb3a31a9790c7bd88d60e6f01e94e7129e0d12b9e4097",
    "afterSha256": "f231b6b819240c385fe085ba91139107714d67224b7f2e51761c599d8d78e7b4",
    "edits": [
      {
        "start": 10561,
        "end": 13539,
        "before": "",
        "after": "\n/* Batch 6: the framework hub shares the cover and ruled-section architecture. */\n@media screen {\n  .framework-hub .framework-home-hero {\n    display: grid;\n    grid-template-columns: var(--editorial-hero-grid);\n    gap: var(--editorial-gap);\n    align-items: start;\n    padding-bottom: var(--editorial-hero-space);\n  }\n  .framework-home-copy,\n  .framework-hub .framework-home-hero > * {\n    min-width: 0;\n  }\n  .framework-hub .framework-hub-intro > .framework-kicker {\n    margin-top: 0;\n  }\n  .framework-hub .framework-chooser {\n    background: var(--editorial-forest);\n    color: var(--editorial-paper);\n    border: 1px solid var(--editorial-forest);\n    border-radius: var(--editorial-radius);\n    padding: var(--editorial-panel-padding);\n  }\n  .framework-hub .framework-chooser h2 {\n    color: inherit;\n    font-size: var(--editorial-h2);\n    font-weight: 400;\n    line-height: var(--editorial-heading-leading);\n    margin: 0 0 1rem;\n  }\n  .framework-hub .framework-chooser ul {\n    display: block;\n    margin: 0;\n  }\n  .framework-hub .framework-chooser li {\n    border-top: 1px solid var(--editorial-anchor-line);\n  }\n  .framework-hub .framework-chooser a {\n    color: inherit;\n    padding-block: 0.75rem;\n    text-decoration: none;\n  }\n  .framework-hub .framework-chooser a span {\n    font-family: var(--font-display);\n    font-size: 1.25rem;\n    font-weight: 400;\n  }\n  .framework-hub .framework-chooser a:hover {\n    text-decoration: underline;\n  }\n  .framework-hub .framework-chooser a:focus-visible {\n    outline: 3px solid var(--editorial-paper);\n    outline-offset: 4px;\n  }\n  .framework-hub .framework-orientation {\n    display: grid;\n    grid-template-columns: var(--editorial-grid);\n    gap: var(--editorial-gap);\n    max-width: none;\n    margin: 0;\n    border-top: 1px solid var(--editorial-line);\n    padding-block: var(--editorial-section-space);\n  }\n  .framework-hub .framework-orientation h2 {\n    font-size: var(--editorial-h2);\n    font-weight: 400;\n    line-height: var(--editorial-heading-leading);\n    margin: 0;\n  }\n  .framework-hub .framework-orientation > div > :first-child {\n    margin-top: 0;\n  }\n  .framework-hub .framework-orientation > div > :last-child {\n    margin-bottom: 0;\n  }\n  .framework-hub .framework-options {\n    border-top: 1px solid var(--editorial-line);\n    padding-top: var(--editorial-section-space);\n    margin-top: 0;\n  }\n  .framework-hub .framework-options article {\n    display: flex;\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  .framework-hub .framework-options article > a {\n    margin-top: auto;\n  }\n  .framework-hub .framework-options article > p:last-of-type {\n    margin-bottom: 1.5rem;\n  }\n  @media (max-width: 768px) {\n    .framework-hub .framework-home-hero,\n    .framework-hub .framework-orientation {\n      grid-template-columns: minmax(0, 1fr);\n    }\n  }\n  @media (forced-colors: active) {\n    .framework-hub .framework-chooser a:focus-visible {\n      outline-color: Highlight;\n    }\n  }\n}\n"
      }
    ]
  },
  "src/style.css": {
    "beforeSha256": "147ccb52c0f5c8f367a08f779dc564b71b8b0ceac6e06b018b13f82285d3884e",
    "afterSha256": "cda845d654450034b94d1d6a281f2224df77bd15184202ba230acc84e70f3c06",
