{
  "name": "only-empowerment",
  "version": "0.1.0-dev.5",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run check && vite build && node scripts/manifest.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
    "verify": "npm run test && npm run build && npm run test:e2e",
    "format": "prettier --write src scripts tests *.ts *.json .github/workflows/*.yml",
    "format:check": "prettier --check src scripts tests *.ts *.json .github/workflows/*.yml"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "prettier": "3.9.7",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
